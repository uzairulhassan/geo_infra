# http-level shared config. It replaces the image's stock default.conf.
# Files in /etc/nginx/templates/*.template are rendered with envsubst into conf.d/.

# Martin lives in this compose project, so a static upstream is fine (and gives keepalive).
upstream martin {
    server martin:3000;
    keepalive 16;
}

# Docker's embedded DNS. The Django apps are in OTHER compose projects, so their
# names are resolved at request time. Nginx still starts if an app is down
# (that app's requests return 502).
resolver 127.0.0.11 valid=10s ipv6=off;

# Share-link tokens live in the PATH (/x/<token>/...), so mask them before logging.
map $uri $log_uri {
    ~^/x/[^/]+/(?<log_rest>.*)$  /x/***/$log_rest;
    default                      $uri;
}

# Main log. Uses $log_uri (no query string, masked share tokens), so ?token=... never reaches the logs.
log_format geo_main '$remote_addr - $remote_user [$time_local] "$request_method $log_uri $server_protocol" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent" rt=$request_time';

# Tile log. tile_token is the token's public prefix (set by Django), or "session" / "-".
log_format geo_tiles '$remote_addr [$time_local] "$request_method $log_uri" $status $body_bytes_sent '
                     'tile_token=$tile_token_id rt=$request_time auth=$tile_auth_time martin=$upstream_response_time';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
