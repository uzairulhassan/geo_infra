# GeoLayers on :8081
#
#   /tiles/geolayers_tile/<z>/<x>/<y>?layer=layer_<hex>  -> auth_request (session/JWT)   -> Martin
#   /x/<token>/<z>/<x>/<y>.pbf                           -> auth_request (Layer URL)     -> Martin
#   /m/<token>/<table>/<z>/<x>/<y>.pbf                   -> auth_request (Map URL)       -> Martin
#   everything else                                      -> GeoLayers Django
#
# Django (tiles-auth/validate/) decides and returns X-Tile-Layer. Nginx always
# proxies with THAT value — the client's ?layer= / path table is never trusted.
# Only geolayers_tile is reachable here; GeoTrak's riyadh_roads is not.
server {
    listen 8081;
    server_name _;

    client_max_body_size 250m;
    access_log /var/log/nginx/access.log geo_main;

    set $geolayers_upstream http://geolayers_web:8000;

    # --------------------------------------------- map builder tiles (signed-in users)
    location ~ ^/tiles/geolayers_tile/(?<tile_z>[0-9]+)/(?<tile_x>[0-9]+)/(?<tile_y>[0-9]+)(?:\.pbf|\.mvt)?$ {
        access_log /dev/stdout geo_tiles;
        include /etc/nginx/snippets/proxy-martin.conf;

        if ($request_method = OPTIONS) {
            return 204;
        }

        include /etc/nginx/snippets/geolayers-tile-auth.conf;

        # Per-user authorization: browsers may cache, shared caches must not.
        add_header Cache-Control "private, max-age=300" always;

        error_page 401 = @geolayers_tile_401;
        error_page 403 = @geolayers_tile_403;

        proxy_pass http://martin/geolayers_tile/$tile_z/$tile_x/$tile_y?layer=$tile_layer;
    }

    # --------------------------------------------- Layer URL tiles (token in path)
    location ~ ^/x/(?<share_token>[A-Za-z0-9_-]+)/(?<tile_z>[0-9]+)/(?<tile_x>[0-9]+)/(?<tile_y>[0-9]+)\.pbf$ {
        access_log /dev/stdout geo_tiles;
        include /etc/nginx/snippets/proxy-martin.conf;

        if ($request_method = OPTIONS) {
            return 204;
        }

        include /etc/nginx/snippets/geolayers-tile-auth.conf;

        # Short TTL so revoke/block/expiry takes effect quickly even for cached clients.
        add_header Cache-Control "public, max-age=60" always;

        error_page 401 = @geolayers_tile_403;
        error_page 403 = @geolayers_tile_403;

        proxy_pass http://martin/geolayers_tile/$tile_z/$tile_x/$tile_y?layer=$tile_layer;
    }

    # --------------------------------------------- Map URL tiles (token + table in path)
    # Use layer_[0-9a-f]+ (not {32}): envsubst treats ${32} as an empty env var and
    # would corrupt the regex. Exact table shape is enforced by Django tile auth.
    location ~ ^/m/(?<share_token>[A-Za-z0-9_-]+)/(?<tile_table>layer_[0-9a-f]+)/(?<tile_z>[0-9]+)/(?<tile_x>[0-9]+)/(?<tile_y>[0-9]+)\.pbf$ {
        access_log /dev/stdout geo_tiles;
        include /etc/nginx/snippets/proxy-martin.conf;

        if ($request_method = OPTIONS) {
            return 204;
        }

        include /etc/nginx/snippets/geolayers-tile-auth.conf;

        add_header Cache-Control "public, max-age=60" always;

        error_page 401 = @geolayers_tile_403;
        error_page 403 = @geolayers_tile_403;

        proxy_pass http://martin/geolayers_tile/$tile_z/$tile_x/$tile_y?layer=$tile_layer;
    }

    location /tiles/ {
        return 404;
    }

    # Internal auth subrequest (not reachable from outside).
    location = /_geolayers_tile_auth {
        internal;
        proxy_pass $geolayers_upstream/tiles-auth/validate/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length      "";
        proxy_set_header Host                $http_host;
        proxy_set_header X-Original-URI      $request_uri;
        proxy_set_header X-Original-Method   $request_method;
        proxy_set_header X-Real-IP           $remote_addr;
        proxy_set_header X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header X-Tile-Auth-Secret  "${GEOLAYERS_TILE_AUTH_SHARED_SECRET}";
        proxy_connect_timeout 3s;
        proxy_read_timeout    5s;
    }

    location ^~ /tiles-auth/ {
        return 404;
    }

    location @geolayers_tile_401 {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        default_type text/plain;
        return 401 "Sign in to GeoLayers, or use a Layer URL / Map URL.\n";
    }

    # Deny reasons from Django → 404 unknown, 410 expired, 403 blocked/forbidden.
    location @geolayers_tile_403 {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        default_type text/plain;
        if ($tile_deny_reason = "not_found") {
            return 404 "Layer URL or Map URL not found.\n";
        }
        if ($tile_deny_reason = "expired") {
            return 410 "This Layer URL or Map URL has expired.\n";
        }
        if ($tile_deny_reason = "blocked") {
            return 403 "This Layer URL or Map URL has been blocked.\n";
        }
        return 403 "You do not have access to this layer.\n";
    }

    # --------------------------------------------- app
    location / {
        include /etc/nginx/snippets/proxy-django.conf;
        proxy_pass $geolayers_upstream;
    }
}
