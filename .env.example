# Copy to .env and replace every value. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL superuser (admin / maintenance only. The apps never use it.)
POSTGRES_PASSWORD=change-me-superuser

# Per-app login roles, created on first start by postgres/init/01-init-databases.sh.
# These MUST match DB_PASSWORD / RIYADH_ROADS_DB_PASSWORD in GeoTrak's .env
# and the password inside GeoLayers' DATABASE_URL.
GEOTRAK_DB_PASSWORD=change-me-geotrak
GEOLAYERS_DB_PASSWORD=change-me-geolayers
MARTIN_DB_PASSWORD=change-me-martin

# Shared secret between Nginx and GeoTrak's tile validation endpoint.
# MUST equal TILE_AUTH_SHARED_SECRET in GeoTrak's .env.
TILE_AUTH_SHARED_SECRET=change-me-long-random-string

# Same idea for GeoLayers (map builder tiles + /x/<share-token>/ links).
# MUST equal TILE_AUTH_SHARED_SECRET in GeoLayers' .env. Use a different value from GeoTrak's.
GEOLAYERS_TILE_AUTH_SHARED_SECRET=change-me-another-long-random-string

# Public ports
GEOTRAK_HTTP_PORT=8000
GEOLAYERS_HTTP_PORT=8081

# Loopback-only Postgres port for psql / pgAdmin via an SSH tunnel
POSTGRES_HOST_PORT=5432

MARTIN_POOL_SIZE=5
MARTIN_WORKERS=2

# Optional: docker compose --profile tools up -d pgadmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
