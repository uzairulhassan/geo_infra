# =============================================================================
# geo-infra — ENV TEMPLATE (copy to .env for local, or to the VPS as .env)
#   cp .env.example .env
# Shared PostGIS + Martin + Nginx for GeoTrak Maps (:8000) and GeoLayers (:8081).
# App .env files must use the matching passwords / tile-auth secrets below.
# Never commit real .env / .env.prod values.
# =============================================================================

# PostgreSQL superuser (maintenance / pg_dump / pgAdmin only — apps never use this)
POSTGRES_PASSWORD=change-me

# Per-app DB login roles (created on first boot by postgres/init/01-init-databases.sh)
# Databases: geotrak + riyadh_roads (geotrak_user), geolayers (geolayers_user)
GEOTRAK_DB_PASSWORD=change-me
GEOLAYERS_DB_PASSWORD=change-me
MARTIN_DB_PASSWORD=change-me

# Nginx ↔ Django tile auth secrets (must match each app's TILE_AUTH_SHARED_SECRET)
TILE_AUTH_SHARED_SECRET=change-me-long-random
GEOLAYERS_TILE_AUTH_SHARED_SECRET=change-me-long-random

# Public HTTP ports
GEOTRAK_HTTP_PORT=8000
GEOLAYERS_HTTP_PORT=8081

# Loopback-only Postgres for psql / SSH tunnel / pgAdmin
# Use 5434 locally if host :5432 is already taken
POSTGRES_HOST_PORT=5432

# Martin (0 = no tile cache; required so GeoTrak edits are not stale)
MARTIN_CACHE_MB=0
MARTIN_POOL_SIZE=5
MARTIN_WORKERS=2

# Optional: docker compose --profile tools up -d pgadmin  →  http://127.0.0.1:5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
